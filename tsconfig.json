{
  "compilerOptions": {
    "target": "ES2020",
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "types": ["jest"],
    "baseUrl": ".",
    "paths": {
      "@shukhratisakdjanov-cyber/faster-mobile": ["src/index.ts"]
    }
  },
  "include": ["src", "tests", "example/App.tsx"]
}
