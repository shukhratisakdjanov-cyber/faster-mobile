{
  "name": "@shukhratisakdjanov-cyber/faster-mobile",
  "version": "0.2.0",
  "description": "Accessible React Native primitives for Faster Mobile.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shukhratisakdjanov-cyber/faster-mobile.git"
  },
  "bugs": {
    "url": "https://github.com/shukhratisakdjanov-cyber/faster-mobile/issues"
  },
  "homepage": "https://github.com/shukhratisakdjanov-cyber/faster-mobile#readme",
  "private": false,
  "packageManager": "pnpm@10.10.0",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/commonjs/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "lib",
    "src"
  ],
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "example:ios": "cd example/native && npm run ios",
    "example:android": "cd example/native && npm run android",
    "maestro:ios": "maestro test .maestro/component-journey.yaml",
    "pack:check": "pnpm pack --pack-destination .artifacts",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "bob build"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.78.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@changesets/cli": "^3.0.0",
    "@react-native/babel-preset": "0.78.0",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "19.0.0",
    "react-native": "0.78.0",
    "react-native-builder-bob": "^0.40.0",
    "react-test-renderer": "19.0.0",
    "typescript": "^5.7.2"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "commonjs",
        {
          "esm": false
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
